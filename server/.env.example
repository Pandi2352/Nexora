# Copy to .env and fill in. Never commit .env.
# The server validates these at startup and refuses to start if any are invalid.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Browser origin allowed to call the API (the Vite dev server in development).
APP_ORIGIN=http://localhost:5173

# MongoDB connection string. Local example below; use Atlas or another host in other environments.
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_os

# Max JSON request body size.
BODY_LIMIT=1mb

# Authentication & JWT (JWT_ACCESS_SECRET must be at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false

# SMTP Email Configuration (optional in development; if unset, emails log to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=app-password-here
MAIL_FROM="Nexora OS <notifications@example.com>"


